# Copy to .env and adjust as needed. All values shown are the defaults.

# RAG engine
DOCS_DIR=./docs
INDEX_PERSIST_DIRECTORY=./data/chromadb
INIT_INDEX=false
OLLAMA_MODEL=llama2
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# HTTP server
HTTP_PORT=7654
FLASK_DEBUG=false

# Only enable if you're behind a proxy with a self-signed cert in local dev.
DISABLE_TLS_VERIFICATION=false

# Reserved for future use - not currently read by the application.
TARGET_URL=https://open5gs.org/open5gs/docs/
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=testuser
MONGO_PASS=testpass
